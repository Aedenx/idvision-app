{
  "functions": {
    "admin/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "backend/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.php"
    },
    {
      "src": "/backend/api/(.*)",
      "dest": "/backend/api/$1"
    }
  ]
}
